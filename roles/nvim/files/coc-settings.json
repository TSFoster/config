{
  "coc.preferences.currentFunctionSymbolAutoUpdate": true,
  "extensions.updateCheck": "never",
  "snippets.ultisnips.directories": ["~/.config/snippets/UltiSnips"],
  "languageserver": {
    "elmLS": {
      "command": "elm-language-server",
      "filetypes": ["elm"],
      "rootPatterns": ["elm.json"],
      "initializationOptions": {
        "elmAnalyseTrigger": "change"
      }
    },
    "efm": {
      "command": "efm-langserver",
      "args": [],
      "filetypes": ["vim", "eruby", "markdown"]
    },
    "dockerfile": {
      "command": "$HOME/.asdf/installs/nodejs/lts/.npm/bin/docker-langserver",
      "args": ["--stdio"],
      "filetypes": ["dockerfile"]
    }
  },
  "codeLens.enable": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic-languageserver.filetypes": {
    "sh": "shellcheck"
  },
  "diagnostic-languageserver.formatFiletypes": {
    "sh": "shfmt"
  },
  "git.gitlab.hosts": ["gitlab.com"],
  "emmet.includeLanguages": {
    "gohtmltmpl": "html"
  },
  "html.filetypes": ["html", "handlebars", "htmldjango", "blade", "gohtmltmpl"],
  "eslint.autoFixOnSave": true,
  "list.insertMappings": {
    "<C-v>": "action:vsplit",
    "<C-x>": "action:split",
    "<C-t>": "action:tabe",
    "<C-l>": "do:toggle"
  },
  "list.normalMappings": {
    "e": "call:Coc_create_file",
    "a": "call:Coc_populate_args",
    "d": "call:Coc_delete_file"
  },
  "list.source.files.command": "fd",
  "list.source.files.args": [
    "--color=never",
    "--exclude=node_modules",
    "--exclude=.git",
    "--exclude=elm-stuff",
    "--exclude=bower_components",
    "--exclude=target",
    "--exclude=.DS_Store",
    "--hidden"
  ],
  "yaml.schemas": {
    "http://json.schemastore.org/ansible-stable-2.9": "/(playbooks|roles|tasks|handlers|defaults|vars|ansible)/*.(yml|yaml)"
  },
  "yaml.format.enable": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.headwind.runOnSave": true
}
