#!/bin/sh

set -eu

tool_versions="$HOME/.tool-versions"
version=""

if [ -r "$tool_versions" ]; then
  version="$(awk '$1 == "python" { print $2; exit }' "$tool_versions")"
fi

if [ -n "$version" ]; then
  exec env ASDF_PYTHON_VERSION="$version" "$HOME/.asdf/shims/python3" "$@"
fi

exec "$HOME/.asdf/shims/python3" "$@"
