#!/bin/sh
# Managed by Ansible; do not edit directly.
#
# 1Password shell plugin wrapper for {{ item }}. This is a real executable on
# PATH (ahead of the real {{ item }}) rather than a shell function, so it's
# picked up by any invocation — including non-interactive shells spawned by
# tools like LLM agents — not just interactive fish/zsh/bash sessions.
#
# `op plugin run -- {{ item }}` resolves {{ item }} by name via PATH, so we
# must strip our own directory out first, or op finds this wrapper again and
# recurses forever.
op_plugin_dir="{{ shells_op_plugin_bin_dir }}"
new_path=
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$op_plugin_dir" ] && continue
  new_path="${new_path:+$new_path:}$dir"
done
IFS=$old_ifs
PATH=$new_path
export PATH
exec {{ shells_op_plugin_run_prefix }} {{ item }} "$@"
