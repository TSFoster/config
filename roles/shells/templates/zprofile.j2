# Managed by Ansible. Keep PATH setup in sync with the shells role.

{% include 'shell-env.sh.j2' %}

if [ -x "{{ homebrew_brew_bin_path }}/brew" ]; then
  eval "$({{ homebrew_brew_bin_path }}/brew shellenv zsh)"
fi

path_append() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="${PATH:+$PATH:}$1" ;;
  esac
}

{% for entry in shells_uv.shell_path_entries %}
path_append "{{ entry }}"
{% endfor %}

if [[ -o interactive ]]; then
{% for entry in shells_uv.shell_path_entries_interactive %}
  path_append "./{{ entry }}"
{% endfor %}
fi

unset -f path_append
export PATH
