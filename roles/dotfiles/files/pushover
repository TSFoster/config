#!/bin/bash
# pushover <message> [title]
# Sends a notification via Pushover API. Wrapped by wrapped_tools — see
# roles/wrapped_tools — which injects PUSHOVER_TOKEN and PUSHOVER_USER.
set -euo pipefail

message="${1:?usage: pushover <message> [title]}"
title="${2:-Notification}"

if [[ -z "${PUSHOVER_TOKEN:-}" || -z "${PUSHOVER_USER:-}" ]]; then
  echo "Error: PUSHOVER_TOKEN and/or PUSHOVER_USER not set." >&2
  echo "Run 'token_renew Pushover' / 'token_renew \"Automation Pushover App\"' to populate them." >&2
  exit 1
fi

token="$PUSHOVER_TOKEN"
user="$PUSHOVER_USER"

curl -s \
  --form-string "token=$token" \
  --form-string "user=$user" \
  --form-string "title=$title" \
  --form-string "message=$message" \
  https://api.pushover.net/1/messages.json >/dev/null
