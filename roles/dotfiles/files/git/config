[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto
[commit]
  verbose = true
[core]
  autocrlf = input
[diff]
  tool = nvr
  algorithm = histogram
[difftool "nvr"]
  cmd = nvr -s -d $LOCAL $REMOTE
[fetch]
  fsckobjects = true
[help]
  autocorrect = 10
[include]
  path = credentials.gitconfig
  path = aliases.gitconfig
[init]
  templatedir = ~/.config/git/templatedir
  defaultBranch = main
[merge]
  tool = nvr
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
[mergetool "nvr"]
  cmd = nvr -s -d $LOCAL $BASE $REMOTE $MERGED -c 'wincmd J | wincmd ='
[pull]
  ff = only
[push]
  default = simple
  autoSetupRemote = true
[rebase]
  autosquash = true
  autostash = true
[receive]
  fsckObjects = true
[rerere]
  enabled = true
  autoupdate = true
[transfer]
  fsckobjects = true
