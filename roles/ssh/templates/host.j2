# Managed by Ansible (roles/ssh) — do not edit by hand.
# Generated from 1Password "Server" item "{{ host.title }}" tagged "{{ ssh_host_tag }}".
{% set ssh_key_paths = {} %}
{% for key_item in ssh_pub_key_items | default([]) %}
{% set _ = ssh_key_paths.update({key_item.title: ssh_dir ~ '/' ~ (key_item.title | regex_replace('[^A-Za-z0-9_.-]', '_')) ~ '.pub'}) %}
{% endfor %}
Host {{ host.title }}
{% for entry in ssh_host_config_fields %}
{% if entry.field in host.fields %}
{% if entry.keyword == 'IdentityFile' and host.fields[entry.field] in ssh_key_paths %}
	IdentityFile {{ ssh_key_paths[host.fields[entry.field]] }}
{% else %}
	{{ entry.keyword }} {{ host.fields[entry.field] }}
{% endif %}
{% endif %}
{% endfor %}
