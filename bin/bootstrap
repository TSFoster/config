#!/usr/bin/env bash

set -e

! [ -t 0 ] && echo 'It looks like your are running this through a pipe. You must clone the repo and call ./bootstrap directly' >&2 && exit 1

# make sure we're one dir above this file
CDPATH='' cd -- "$(dirname -- "$0")"/..

if [ "$(basename "$0")" != bootstrap ] || [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$PWD" ] || [ "$(git remote get-url origin 2>/dev/null)" != 'git@github.com:TSFoster/config.git' ]; then
  echo "Something's wrong with how this file is being executed. Please clone the repo and call ./bootstrap directly" >&2
  exit 1
fi

OS="$(uname -s)"
ASDF_PYTHON_SPEC="latest:3"

if [[ "$OS" == "Darwin" ]]; then
  # if brew isn't in path, let's check default install location before trying to install it
  BREW_LOCATION=$(command -v brew || ([ "$(uname -m)" = arm64 ] && echo /opt/homebrew/bin/brew || echo /usr/local/bin/brew))

  ! [ -x "$BREW_LOCATION" ] && echo "Can't find homebrew. Installing" >&2 && /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  ! [ -x "$BREW_LOCATION" ] && echo "Still can't find homebrew. Aborting" >&2 && exit 1

  eval "$($BREW_LOCATION shellenv)"

  ! command -v go >/dev/null && echo "Can't find go. Installing" >&2 && brew install go

  ! command -v op >/dev/null && echo "Can't find 1password-cli. Installing" >&2 && brew install 1password-cli

elif [[ "$OS" == "Linux" ]]; then
  # Install core packages
  sudo apt-get update -qq
  sudo apt-get install -y git golang-go

  # Install 1Password CLI via official apt repository
  # https://developer.1password.com/docs/cli/get-started/#install
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor -o /usr/share/keyrings/1password-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] \
    https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" |
    sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
  sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
  curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol |
    sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol >/dev/null
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor -o /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
  sudo apt-get update -qq && sudo apt-get install -y 1password-cli

else
  echo "Unsupported OS: $OS" >&2
  exit 1
fi

if [ -z "${GOPATH:-}" ]; then
  export GOPATH="$HOME/.local/share/go"
fi

path_prepend() {
  case ":$PATH:" in
  *":$1:"*) ;;
  *) PATH="$1${PATH:+:$PATH}" ;;
  esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$GOPATH/bin"
export PATH

ASDF_GO_BINARY="$GOPATH/bin/asdf"

if ! [ -x "$ASDF_GO_BINARY" ]; then
  echo "Installing asdf via go install" >&2
fi
go install github.com/asdf-vm/asdf/cmd/asdf@latest

! "$ASDF_GO_BINARY" plugin list | grep -q '^python$' && echo "Installing asdf python plugin" >&2 && "$ASDF_GO_BINARY" plugin add python
! "$ASDF_GO_BINARY" list python 3 >/dev/null && echo "Installing python 3 via asdf" >&2 && "$ASDF_GO_BINARY" install python "$ASDF_PYTHON_SPEC"

ASDF_PYTHON_VERSION="$("$ASDF_GO_BINARY" list python 3 | sed 's/^ *\**//' | sort -V | tail -n 1)"
ASDF_PYTHON_BIN="$("$ASDF_GO_BINARY" where python "$ASDF_PYTHON_VERSION")/bin"
ASDF_PIP3="$ASDF_PYTHON_BIN/pip3"
ASDF_PYTHON3="$ASDF_PYTHON_BIN/python3"
ASDF_ANSIBLE_PLAYBOOK="$ASDF_PYTHON_BIN/ansible-playbook"

if ! [ -x "$ASDF_PIP3" ] || ! [ -x "$ASDF_PYTHON3" ]; then
  echo "Failed to locate the asdf-managed Python installation" >&2
  exit 1
fi

! [ -x "$ASDF_ANSIBLE_PLAYBOOK" ] && echo "Can't find ansible in asdf python. Installing" >&2 && "$ASDF_PIP3" install ansible

printf 'Checking 1Password\n' >&2
eval "$(op signin)"

if ! [ -f vault_pass ]; then
  echo "Can't find vault password. Retrieving" >&2
  op item get --fields password 'Config vault' >vault_pass
fi

echo "Installing Ansible collections" >&2 && "$ASDF_PYTHON_BIN/ansible-galaxy" collection install --upgrade -r collections/requirements.yml

echo "Running playbook" >&2 && "$ASDF_ANSIBLE_PLAYBOOK" -i "localhost ansible_python_interpreter=$ASDF_PYTHON3," main.yml "$@"
